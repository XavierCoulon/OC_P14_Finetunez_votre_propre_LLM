# Copier ce fichier en .env et renseigner les valeurs
# Token HuggingFace avec droits write : https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Repo cible (namespace/nom)
HF_DATASET_REPO=xxxxxx/yyyyyyyy

# true = privé, false = public
HF_PRIVATE=true

# Wandb API key : https://wandb.ai
WANDB_API_KEY=wandb_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral API key (évaluation RAGAS) : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API CHSA Triage — clé d'accès à l'endpoint FastAPI
# Générer avec : openssl rand -hex 32
API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL du serveur vLLM (local ou HF Inference Endpoints)
# Local :  http://localhost:8000
# HF :     https://xxxx.eu-west-1.aws.endpoints.huggingface.cloud
VLLM_URL=https://xxxx.eu-west-1.aws.endpoints.huggingface.cloud

# Modèle merged pour vLLM (généré depuis les adapters DPO)
MODEL_NAME=XavierCoulon/qwen3-1.7b-chsa-dpo-merged
